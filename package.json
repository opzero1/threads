{
  "name": "@op1/threads",
  "version": "0.3.4",
  "description": "Opinionated background agents for OpenCode V2: visible worker sessions that report back with a verdict, and durable parallel workflows that survive restarts.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.js"
  },
  "files": ["index.ts", "tui.js", "bin/op-threads-heartbeat.mjs", "tsconfig.json", "src/", "skills/", "docs/", "CHANGELOG.md"],
  "bin": { "op-threads-heartbeat": "./bin/op-threads-heartbeat.mjs" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opzero1/threads.git"
  },
  "homepage": "https://github.com/opzero1/threads#readme",
  "bugs": "https://github.com/opzero1/threads/issues",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "background-agents",
    "multi-agent",
    "parallel-agents",
    "subagents",
    "agent-orchestration",
    "ai-agents",
    "coding-agents",
    "workflows",
    "durable-workflows",
    "delegation",
    "agent-workflows",
    "typescript",
    "bun",
    "tui",
    "threads",
    "opinionated"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build:tui": "bun scripts/build-tui.ts",
    "build:heartbeat": "bun scripts/build-heartbeat.ts",
    "prepack": "bun run build:tui && bun run build:heartbeat",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:live": "uv run --with pyte python scripts/verify-live.py",
    "verify:package-ui": "uv run --with pyte python scripts/verify-package-ui.py",
    "verify:roles": "python3 scripts/verify-roles.py",
    "verify:footer": "uv run --with pyte python scripts/verify-footer.py",
    "verify:workflows": "uv run --with pyte python scripts/verify-workflows.py",
    "verify:workflow-regressions": "python3 scripts/verify-workflow-regressions.py",
    "verify:workflow-capacity": "python3 scripts/verify-workflow-capacity.py",
    "verify:workflow-cleanup": "python3 scripts/verify-workflow-cleanup.py",
    "verify:workflow-runtime": "bun scripts/verify-workflow-runtime.ts"
  },
  "dependencies": {
    "@opencode/client": "2.1.2",
    "@opencode/codemode": "2.1.2",
    "@opencode/plugin": "2.1.2",
    "@opencode/schema": "2.1.2",
    "acorn": "8.15.0",
    "ajv": "8.17.1",
    "effect": "4.0.1",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "1.4.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
